# goodreads — copy to .env and edit. Keep mode 600.

# Encrypts the credentials table. Losing this means re-entering every
# credential through the Settings page — it is not recoverable.
GOODREADS_SECRET_KEY=

# Goodreads numeric user id, from the URL of your profile:
#   https://www.goodreads.com/review/list/12345678-your-name  ->  12345678
GOODREADS_USER_ID=

# Refuse to start an audiobook download below this much free space (GB).
MIN_FREE_SPACE_GB=50

# How often the scheduler sweeps for work, in seconds.
POLL_INTERVAL=15

# Bind address for the UI/API *inside the container*.
BIND=0.0.0.0
PORT=8090

# Which host interface to publish the UI on. Leave it unset unless you have
# confirmed what actually dials the app.
#
# 0.0.0.0 (the default) publishes on every interface, which is what ufw and a
# home firewall are usually assumed to be covering — and frequently are not,
# because docker's iptables rules are evaluated before the firewall's. So it is
# worth narrowing, and narrowing it wrongly takes the app offline.
#
# *** Confirm the front end's target before you change this. *** A binding to
# one address only answers on that address: set it to 127.0.0.1 while a proxy
# container dials the host's bridge gateway and every request is refused, which
# shows up as a 502 from whatever sits in front. How to tell:
#
#     docker compose logs goodreads | grep 'GET /login'
#
# the address in the left column is where the front end reaches you from. A
# published port answers on the host's addresses, and a container reaching the
# host arrives *as its bridge gateway* (172.x.0.1), not as 127.0.0.1 — so a
# reverse proxy or tunnel running in a container generally needs 0.0.0.0, and
# only a proxy or tunnel running on the host itself can use 127.0.0.1.
#
#   PUBLISH_HOST=0.0.0.0       # every interface; safe default
#   PUBLISH_HOST=127.0.0.1     # a proxy/tunnel running on the host, or an
#                              # SSH tunnel
#   PUBLISH_HOST=100.64.0.1    # one VPN interface (Tailscale, WireGuard)
#   PUBLISH_HOST=192.168.1.50  # one LAN address
#
# Note what this does and does not do: it decides which of the host's own
# addresses the port is published on. It does not decide whether the app is
# reachable from the internet — a tunnel in front reaches it either way.
# PUBLISH_HOST=

# Set to 1 once goodreads is only ever reached over HTTPS. Leaving it on over
# plain HTTP makes the browser drop the session cookie and login silently fails.
COOKIE_SECURE=0

# Set to 1 only when a reverse proxy you control rewrites X-Forwarded-For.
# The header is client-supplied, so trusting it without one lets any caller
# rotate it and bypass the per-client sign-in limit.
TRUST_PROXY=0

# What this app is reached *as*, when a reverse proxy rewrites the Host header.
# The same-origin check on state-changing requests and on the VNC handshake
# compares a request's Origin against it, and without this a proxy deployment
# makes those disagree — the symptom is the VNC panel silently never
# connecting. Scheme and port included, no trailing slash.
# PUBLIC_ORIGIN=https://goodreads.example.com

# goodreads — copy to .env and edit. Keep mode 600.

# Encrypts the credentials table. Losing this means re-entering every
# credential through the Settings page — it is not recoverable.
GOODREADS_SECRET_KEY=

# Goodreads numeric user id, from the URL of your profile:
#   https://www.goodreads.com/review/list/12345678-your-name  ->  12345678
GOODREADS_USER_ID=

# Refuse to start an audiobook download below this much free space (GB).
MIN_FREE_SPACE_GB=50

# How often the scheduler sweeps for work, in seconds.
POLL_INTERVAL=15

# Bind address for the UI/API.
BIND=0.0.0.0
PORT=8090

# Set to 1 once goodreads is only ever reached over HTTPS. Leaving it on over
# plain HTTP makes the browser drop the session cookie and login silently fails.
COOKIE_SECURE=0
